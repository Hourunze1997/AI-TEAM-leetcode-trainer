<UserControl x:Class="LeetCodeTrainer.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="学习统计" FontSize="22" FontWeight="Bold"/>

            <Border Background="#2563EB" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <TextBlock Text="{Binding SolvedText}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="8" Margin="0,0,6,0">
                    <lvc:PieChart Series="{Binding Difficulties}" Height="300" LegendPosition="Right"/>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="8" Margin="6,0,0,0">
                    <lvc:CartesianChart Series="{Binding Trend}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="300"/>
                </Border>
            </Grid>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="220">
                <TextBlock Text="{Binding StreakDays, StringFormat=连续打卡：{0} 天}"
                           FontSize="15" FontWeight="SemiBold"/>
            </Border>

            <TextBlock Text="收藏题目" FontSize="16" FontWeight="Bold" Margin="0,16,0,6"/>
            <ListBox ItemsSource="{Binding FavoriteQuestions}" MinHeight="80"
                     BorderBrush="#E2E8F0" BorderThickness="1"
                     MouseDoubleClick="FavoriteList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FrontendId, StringFormat={}{0}.}" Margin="0,0,6,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Difficulty}" Margin="10,0,0,0"
                                       Foreground="{Binding Difficulty, Converter={StaticResource DifficultyToBrush}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
