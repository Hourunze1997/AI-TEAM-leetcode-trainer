<Application x:Class="LeetCodeTrainer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeetCodeTrainer.ViewModels"
             xmlns:views="clr-namespace:LeetCodeTrainer.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel -> View 映射 -->
            <DataTemplate DataType="{x:Type vm:QuestionListViewModel}">
                <views:QuestionListView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestionDetailViewModel}">
                <views:QuestionDetailView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
                <views:StatisticsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
